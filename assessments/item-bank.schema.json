{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vladimiracunadev-create.github.io/chilean-school-learning-path/schemas/item-bank.schema.json",
  "title": "Banco de ítems y tareas originales",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bank_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "bank_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "levels", "subject_domains", "skill_ids", "oa_codes", "difficulty", "task_type", "context", "stimulus", "prompt", "scoring", "framework_links", "authorship", "license", "review", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^item\\.[a-z0-9-]+\\.[0-9]{2}$"},
        "title": {"type": "string", "minLength": 5},
        "levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 12}},
        "age_range": {"type": ["object", "null"], "properties": {"min": {"type": "integer", "minimum": 5}, "max": {"type": "integer", "minimum": 5}}, "required": ["min", "max"], "additionalProperties": false},
        "subject_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "skill_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "oa_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "prerequisite_skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "difficulty": {"enum": ["foundational", "consolidation", "application", "reasoning", "transfer", "advanced"]},
        "task_type": {"enum": ["multiple_choice", "multiple_select", "complex_multiple_choice", "short_response", "developed_response", "mathematical_resolution", "explanation", "argumentation", "chart_interpretation", "table_interpretation", "comparison", "synthesis", "essay", "project", "interdisciplinary_problem"]},
        "context": {"type": "string", "minLength": 5},
        "stimulus": {"type": "object", "minProperties": 1},
        "prompt": {"type": "string", "minLength": 10},
        "answer": {},
        "worked_solution": {"type": "string"},
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criteria", "rubric"],
          "properties": {
            "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "rubric": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["level", "descriptor"], "properties": {"level": {"type": "string"}, "descriptor": {"type": "string"}}, "additionalProperties": false}
          }
        },
        "options": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "text", "correct"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "correct": {"type": "boolean"}, "error_pattern_id": {"type": ["string", "null"]}, "interpretation": {"type": "string"}}, "additionalProperties": false},
        "framework_links": {"type": "array", "items": {"type": "object", "required": ["framework_id", "alignment_type", "note"], "properties": {"framework_id": {"type": "string"}, "alignment_type": {"enum": ["official", "pedagogical_inference", "project_proposal"]}, "note": {"type": "string"}}, "additionalProperties": false},
        "authorship": {"type": "string", "minLength": 3},
        "license": {"type": "string", "minLength": 3},
        "review": {"enum": ["draft", "internal_review", "expert_review", "piloted", "analyzed", "validated"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"task_type": {"enum": ["multiple_choice", "multiple_select", "complex_multiple_choice"]}}},
          "then": {"required": ["options", "answer"]}
        }
      ]
    }
  }
}
