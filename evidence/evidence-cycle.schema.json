{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vladimiracunadev-create.github.io/chilean-school-learning-path/schemas/evidence-cycle.schema.json",
  "title": "Ciclo longitudinal de evidencia pedagógica",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "learner_ref", "privacy", "skill_id", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "cycle_id": {"type": "string", "pattern": "^cycle\\.[a-z0-9-]+\\.[0-9]{2}$"},
    "learner_ref": {"type": "string", "pattern": "^(SYNTH|LOCAL)-[A-Z0-9-]{3,32}$"},
    "privacy": {"const": "no_personal_data"},
    "skill_id": {"type": "string"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "occurred_at", "session_id", "context", "note"],
      "properties": {
        "id": {"type": "string", "pattern": "^ev-[0-9]{3,}$"},
        "type": {"enum": ["observation", "hypothesis", "intervention", "practice", "reassessment", "pedagogical_diagnosis", "mastery_decision"]},
        "occurred_at": {"type": "string", "format": "date-time"},
        "session_id": {"type": "string", "minLength": 2},
        "context": {"type": "string", "minLength": 3},
        "item_id": {"type": ["string", "null"]},
        "item_type": {"type": ["string", "null"]},
        "result": {"enum": ["not_yet_observable", "developing", "achieved", "deepened", "access_barrier", "insufficient_evidence", "not_applicable"]},
        "error_pattern_id": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "decision": {"enum": ["supported", "rejected", "revise", "not_applicable"]},
        "intervention_oa_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "responsible_role": {"type": "string"},
        "note": {"type": "string", "minLength": 5}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["observation", "practice", "reassessment"]}}}, "then": {"required": ["item_id", "item_type", "result"]}},
        {"if": {"properties": {"type": {"enum": ["hypothesis", "pedagogical_diagnosis", "mastery_decision"]}}}, "then": {"required": ["evidence_refs", "decision", "responsible_role"]}},
        {"if": {"properties": {"type": {"const": "intervention"}}}, "then": {"required": ["evidence_refs", "intervention_oa_codes", "responsible_role"]}}
      ]
    }
  }
}
